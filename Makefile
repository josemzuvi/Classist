# Compiler and flags
CC := gcc
CFLAGS := -Iheaders -Isrc -Igenerated -Wall -Wextra -O2
CLASSIST_CFLAGS := -Iheaders -Isrc -Iclassist -fno-toplevel-reorder -O2

# Directories and targets
SRC_DIR := src
GEN_DIR := generated
BUILD_DIR := build
BIN := $(BUILD_DIR)/app

# Source files
CLS_HEADERS := $(shell find $(SRC_DIR) -name "*.cls.h" 2>/dev/null)
SRCS := $(shell find $(SRC_DIR) -name "*.c" 2>/dev/null)
OBJS := $(patsubst $(SRC_DIR)/%.c, $(BUILD_DIR)/%.o, $(SRCS))

# Default target
.PHONY: all
all: build

# -------------------------------------------------------------
# Classist Build Targets
# -------------------------------------------------------------

# Generates _registry.c with includes relative to src/
classist/_registry.c: $(CLS_HEADERS)
	@mkdir -p classist
	@echo "// Automatically generated by Classist build" > $@
	@for f in $(CLS_HEADERS); do \
		rel=$${f#$(SRC_DIR)/}; \
		echo "#include \"$$rel\"" >> $@; \
	done

# Compiles the Classist code generator
classist/classist_gen: classist/classist.c classist/_registry.c
	@$(CC) $(CLASSIST_CFLAGS) $^ -o $@

# Alias: make cls (generates headers and skeletons)
.PHONY: cls
cls: classist-generate

# Generates headers (.h) and source skeletons (.c)
.PHONY: classist-generate
classist-generate: classist/classist_gen
	@mkdir -p $(GEN_DIR) $(SRC_DIR)
	@./classist/classist_gen --out $(GEN_DIR) --src $(SRC_DIR)

# Cleans generator temporary files
.PHONY: classist-clean
classist-clean:
	@rm -f classist/_registry.c classist/classist_gen
	@echo "[Classist] Generator temporary files removed."

# -------------------------------------------------------------
# Main Project Targets
# -------------------------------------------------------------

# Builds the final executable (ensuring make cls runs first)
.PHONY: build
build: cls $(BIN)

# Links the final binary
$(BIN): $(OBJS)
	@mkdir -p $(BUILD_DIR)
	@$(CC) $(OBJS) -o $@
	@echo "[Build] Binary created at $@"

# Compiles object files (.c -> .o)
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@

# Runs the application
.PHONY: run
run: build
	@echo "[Run] Executing $(BIN)..."
	@./$(BIN)

# Cleans build objects and classist temporaries
.PHONY: clean
clean: classist-clean
	@rm -rf $(BUILD_DIR)
	@echo "[Clean] Directory $(BUILD_DIR)/ removed."

# Deep clean (also removes generated/)
.PHONY: distclean
distclean: clean
	@rm -rf $(GEN_DIR)
	@echo "[Distclean] Directory $(GEN_DIR)/ removed."

# Help menu
.PHONY: help
help:
	@echo "Available Makefile targets:"
	@echo "  make cls              - Run Classist: generate .h in generated/ and create skeletons in src/"
	@echo "  make build (or make)   - Run Classist and build the final application at build/app"
	@echo "  make run              - Build and execute the application (build/app)"
	@echo "  make clean            - Remove build/ directory and classist temporaries"
	@echo "  make distclean        - Remove build/, generated/, and classist temporaries"
	@echo "  make classist-clean   - Remove only classist generator temporaries"
	@echo "  make help             - Show this help menu"
